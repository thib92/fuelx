    "Protein" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protéines"
          }
        }
      }
    },
    "Protein is set per kg of body weight, fat as a share of calories, and carbs get the rest. Sports nutrition guidelines suggest 1.2–2.0 g/kg of protein and 20–35% fat." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les protéines sont définies par kg de poids corporel, les lipides en part des calories, et les glucides complètent le reste. Les recommandations en nutrition sportive conseillent 1,2–2,0 g/kg de protéines et 20–35 % de lipides."
          }
        }
      }
    },
    "Raised to your resting energy: eating less isn't recommended." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relevé à votre métabolisme de base : manger moins n’est pas recommandé."
          }
        }
      }
    },
    "Rate" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rythme"
          }
        }
      }
    },
